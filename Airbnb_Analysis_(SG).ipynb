      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Load the Airbnb dataset\n",
        "Airbnb_df = pd.read_csv(\"C:\\\\Users\\\\jabhi\\\\Downloads\\\\Capstone-EDA-project-Airbnb-bookings-analysis-main\\\\Capstone-EDA-project-Airbnb-bookings-analysis-main\\\\Airbnb NYC 2019.csv\")\n",
        "\n",
        "# Group by 'neighbourhood' and calculate average minimum price\n",
        "avg_min_price = Airbnb_df.groupby('neighbourhood')['price'].mean().reset_index()\n",
        "avg_min_price = avg_min_price.rename(columns={'price': 'avg_price'})\n",
        "\n",
        "# Select top 10 neighborhoods with the lowest average price\n",
        "top10_neighbourhoods = avg_min_price.sort_values(by='avg_price').head(10)\n",
        "\n",
        "# Add neighbourhood_group to the selected top 10\n",
        "top10_neighbourhoods = top10_neighbourhoods.merge(\n",
        "    Airbnb_df[['neighbourhood', 'neighbourhood_group']].drop_duplicates(),\n",
        "    on='neighbourhood',\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "# ✅ Display result without hide_index (compatible with all pandas versions)\n",
        "print(\"\\nTop 10 Neighborhoods with Lowest Average Airbnb Prices:\")\n",
        "print(top10_neighbourhoods)\n",
        "\n",
        "# --------------------------------------\n",
        "# 📊 Bar Chart\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.barplot(x='avg_price', y='neighbourhood', data=top10_neighbourhoods, hue='neighbourhood_group', dodge=False)\n",
        "plt.title('Top 10 Neighborhoods with Lowest Average Airbnb Prices')\n",
        "plt.xlabel('Average Minimum Price')\n",
        "plt.ylabel('Neighborhood')\n",
        "plt.legend(title='Neighbourhood Group')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# --------------------------------------\n",
        "# 🔵 Scatter Plot\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x='avg_price', y='neighbourhood', data=top10_neighbourhoods, hue='neighbourhood_group', s=100)\n",
        "plt.title('Average Minimum Price per Neighborhood (Cheapest 10)')\n",
        "plt.xlabel('Average Minimum Price')\n",
        "plt.ylabel('Neighborhood')\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
