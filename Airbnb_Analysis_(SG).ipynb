        "    autopct='%1.1f%%',\n",
        "    startangle=140,\n",
        "    colors=colors\n",
        ")\n",
        "plt.title('Total Reviews by Each Neighborhood Group')\n",
        "plt.axis('equal')  # Equal aspect ratio ensures pie is drawn as a circle\n",
